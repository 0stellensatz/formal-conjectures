module

public import FormalConjecturesUtil
public import FormalConjectures.Wikipedia.InverseGalois

/-!
# Shafarevich's conjecture on the absolute Galois group of $\mathbb{Q}^{ab}$

Let $\mathbb{Q}^{ab} = \mathbb{Q}(\mu_\infty)$ be the maximal abelian extension of $\mathbb{Q}$.
Shafarevich conjectured that its absolute Galois group $G_{\mathbb{Q}^{ab}}$ is a free profinite
group. Since $\mathbb{Q}^{ab}$ is countable and Hilbertian, the rank would be $\aleph_0$.
It is a special case of the Fried–Völklein conjecture `DebesDeschamps.fried_volklein`.

Mathlib has no free profinite groups. We state the conjecture with Iwasawa's criterion
[FJ08, Cor. 24.8.3]: a profinite group of rank at most $\aleph_0$ is free of rank $\aleph_0$ if
and only if every finite embedding problem for it is properly solvable.

*References:*
- [BSF11] L. Bary-Soroker, A. Fehm, *Open problems in the theory of ample fields*,
  [arXiv:1106.1310](https://arxiv.org/abs/1106.1310), Conjecture 3.1.
- [FJ08] M. D. Fried, M. Jarden, *Field Arithmetic*, 3rd ed., Springer, 2008,
  Remark 16.9.5, Corollary 24.8.3, Example 24.8.5 (a).
- [MM18] G. Malle, B. H. Matzat, *Inverse Galois Theory*, 2nd ed., Springer, 2018,
  Section IV.3.3, Conjecture IV.3.11.
-/

@[expose] public section

namespace Shafarevich

open EmbeddingProblem

/-- $\mathbb{Q}^{ab}$, the subfield of `AlgebraicClosure ℚ` generated by all roots of unity. -/
local notation "ℚᵃᵇ" => IntermediateField.cyclotomicClosure ℚ

/-- The absolute Galois group of $\mathbb{Q}^{ab}$, with the Krull topology. -/
local notation "G" => Field.absoluteGaloisGroup ℚᵃᵇ

/-- **Shafarevich's conjecture.** Every finite embedding problem for $G_{\mathbb{Q}^{ab}}$ is
properly solvable. By Iwasawa's criterion this is equivalent to
$G_{\mathbb{Q}^{ab}} \cong \hat{F}_\omega$, the free profinite group of countable rank. -/
@[category research open, AMS 12 20]
theorem shafarevich {A B : Type} [Group A] [Group B] (α : G →* A) (β : B →* A)
    (h : IsFinite α β) : ∃ γ, IsProperSolution α β γ := by
  sorry

/-- Every finite group is a Galois group over $\mathbb{Q}^{ab}$. This is the case $A = 1$ of
`shafarevich`. -/
@[category research open, AMS 12 20]
theorem shafarevich.variants.inverse_galois {B : Type*} [Group B] [Finite B] :
    InverseGalois.IsRealizable ℚᵃᵇ B := by
  sorry

/-- $G_{\mathbb{Q}^{ab}}$ is projective, because its cohomological dimension is $1$ (Tate).
Equivalently, every finite embedding problem for it has a weak solution. -/
@[category research solved, AMS 12 20]
theorem shafarevich.variants.projective {A B : Type} [Group A] [Group B] (α : G →* A)
    (β : B →* A) (h : IsFinite α β) : ∃ γ, IsWeakSolution α β γ := by
  sorry

/-- The maximal prosolvable quotient of $G_{\mathbb{Q}^{ab}}$ is free prosolvable of countable
rank (Iwasawa, 1953). Equivalently, every finite embedding problem for $G_{\mathbb{Q}^{ab}}$
with solvable $B$ is properly solvable. -/
@[category research solved, AMS 12 20]
theorem shafarevich.variants.prosolvable {A B : Type} [Group A] [Group B] [Group.IsSolvable B]
    (α : G →* A) (β : B →* A) (h : IsFinite α β) : ∃ γ, IsProperSolution α β γ := by
  sorry

end Shafarevich
